  m_EditorClassIdentifier: Assembly-CSharp::TutorialPromptManager
  promptCanvasGroup: {fileID: 512275233}
  promptText: {fileID: 1636275937}
  fadeDuration: 0.3
  prompts:
  - id: 0
    message: Try combining different materials together to discover what they can
      create.
    displayDuration: 5
  - id: 1
    message: Some creations can be changed further. Try clicking one to see what
      you can do with it.
    displayDuration: 5
  - id: 2
    message: Objects can have different actions available. Experiment with them to
      discover new results.
    displayDuration: 5
  - id: 3
    message: Different actions can transform objects in different ways. Keep experimenting
      to discover what they do.
    displayDuration: 5
  - id: 4
    message: Recycling certain objects returns useful materials that you can use
      again later.
    displayDuration: 5
  - id: 5
    message: Undo lets you take back your most recent change if you want to try something
      different.
    displayDuration: 5
  - id: 6
    message: Final creations you discover can be viewed again from the Final Items
      menu.
    displayDuration: 5
  - id: 7
    message: Welcome! Click a material on the bottom and place it in the world to
      get started.
    displayDuration: 6
