  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialPromptManager
  promptCanvasGroup: {fileID: 512275233}
  promptText: {fileID: 1636275937}
  fadeDuration: 1
  prompts:
  - id: 0
    message: Try combining different materials together to discover what they can
      create.
    displayDuration: 5
  - id: 1
    message: When creating new objects, you generate waste as a byproduct. Try recycling
      them.
    displayDuration: 5
  - id: 2
    message: Objects have actions that you can perform, such as seeing it's history.
    displayDuration: 5
  - id: 3
    message: Some actions can change an object further, and may require recycled
      resources.
    displayDuration: 5
  - id: 4
    message: Recycling waste returns useful materials that you can use again later.
    displayDuration: 5
  - id: 5
    message: Undo lets you take back your most recent change if you want to try something
      different.
    displayDuration: 5
  - id: 6
    message: Final creations you discover can be viewed again from the Final Items
      menu.
    displayDuration: 5
  - id: 7
    message: Welcome! Click a material on the bottom and place it in the world to
      get started.
    displayDuration: 7
